#!/bin/sh
# push 前自动跑发布门禁，漏脱敏就推不出去。
# 启用（在仓库根执行一次，hook 随仓库走、每台 clone 都要自己启用一次）：
#     git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

# GUI 启动的编辑器 PATH 可能不含 Homebrew 的 python3，逐级回退。
PY="$(command -v python3 2>/dev/null || true)"
[ -n "$PY" ] || { [ -x /usr/bin/python3 ] && PY=/usr/bin/python3; }
if [ -z "$PY" ]; then
    echo "pre-push: 找不到 python3，无法运行发布门禁；请先手动执行 make check。" >&2
    exit 1
fi

"$PY" scripts/prepublish_check.py || {
    echo "pre-push: 发布门禁未通过，已阻止 push。" >&2
    exit 1
}
