# 本机配置模板 —— 复制成 config.env 再按自己的部署修改。
# config.env 已被 .gitignore 排除，永远不会被提交或推送。
#
# 格式：纯 KEY=VALUE，支持 # 注释；值可用单/双引号包裹（路径含空格时建议加引号）。
# panel.sh 会逐行解析并 export，刻意不使用 source，避免执行配置文件里的任意命令。
# 不写任何一项就用下面的默认值。

# 数据 / 配置目录：server.conf、proxy-runtime.conf、logs/ 都在这里
PANEL_LAB=~/mlx-lab

# 面板监听端口（绑定地址固定 127.0.0.1，不可改成 0.0.0.0）
PANEL_PORT=8090

# 运行面板的 Python；零第三方依赖，系统 python3 即可
PANEL_PYTHON=python3

# 面板代码路径；一般不用改，panel.sh 默认取同目录的 ops_panel.py
# PANEL_SCRIPT=/path/to/ops_panel.py

# 两个运维命令。若你没有这两个脚本，面板仍能启动，相关采集会显示占位符。
PANEL_MLXCTL=~/mlx-lab/bin/mlxctl
PANEL_PROXYCTL=~/mlx-lab/bin/proxyctl

# 观测代理健康接口
PANEL_HEALTH_URL=http://127.0.0.1:8083/health

# 逐请求观测日志（JSONL，每行一条）
PANEL_RECORD=~/mlx-lab/logs/proxy-8083.jsonl

# 读取中的配置文件
PANEL_SERVER_CONF=~/mlx-lab/server.conf
PANEL_RUNTIME_CONF=~/mlx-lab/proxy-runtime.conf

# 面板操作审计日志（只写 output 前 200 字符）
PANEL_AUDIT=~/mlx-lab/logs/ops-panel-audit.jsonl

# launchd 标签，逗号分隔。每台机器不同，默认留空即不查询 launchd。
# 例：PANEL_LAUNCHD_LABELS=com.example.mlx.server,com.example.mlx.proxy
PANEL_LAUNCHD_LABELS=

# 状态卡片关注的端口，逗号分隔
PANEL_WATCHED_PORTS=8080,8081,8083,8090
